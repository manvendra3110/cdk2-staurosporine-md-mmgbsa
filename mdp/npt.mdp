define = -DPOSRES
integrator = md
dt = 0.002
nsteps = 100000
nstxout-compressed = 5000
continuation = yes
constraints = h-bonds
constraint_algorithm = lincs
tcoupl = V-rescale
tc-grps = Protein_LIG Water_and_ions
tau_t = 0.1 0.1
ref_t = 300 300
pcoupl = C-rescale
pcoupltype = isotropic
tau_p = 2.0
ref_p = 1.0
compressibility = 4.5e-5
refcoord_scaling = com
gen_vel = no
cutoff-scheme = Verlet
nstlist = 10
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
fourierspacing = 0.16
pbc = xyz
DispCorr = EnerPres