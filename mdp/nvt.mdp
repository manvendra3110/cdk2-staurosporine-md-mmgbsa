define = -DPOSRES
integrator = md
dt = 0.002
nsteps = 50000
nstxout-compressed = 5000
continuation = no
constraints = h-bonds
constraint_algorithm = lincs
tcoupl = V-rescale
tc-grps = Protein_LIG Water_and_ions
tau_t = 0.1 0.1
ref_t = 300 300
pcoupl = no
gen_vel = yes
gen_temp = 300
cutoff-scheme = Verlet
nstlist = 10
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
fourierspacing = 0.16
pbc = xyz
DispCorr = EnerPres